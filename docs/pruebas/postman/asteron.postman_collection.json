{
  "info": {
    "name": "Asteron API — pruebas",
    "description": "Casos CP-API-01 a CP-API-29 de docs/pruebas/matriz-casos-prueba.md. Se ejecuta en orden (cada carpeta usa variables de la anterior) contra el ambiente de pruebas (backend en el puerto 3001 sobre la BD asteron_test). Ver docs/pruebas/plan-de-pruebas.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación y sesión",
      "item": [
        {
          "name": "CP-API-01 · Health check con la BD arriba",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('El sistema reporta estado ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-API-02 · Login válido (Administrador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{clave_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const u = pm.response.json().user;",
                  "pm.test('Devuelve token JWT', () => pm.expect(u.token.split('.')).to.have.lengthOf(3));",
                  "pm.test('Devuelve el rol', () => pm.expect(u.rol).to.eql('Administrador Sistema'));",
                  "pm.test('No expone el hash de la contraseña', () => pm.expect(JSON.stringify(u)).to.not.include('password_hash'));",
                  "pm.collectionVariables.set('token_admin', u.token);"
                ]
              }
            }
          ]
        },
