    {
      "name": "3. Programación de planta",
      "item": [
        {
          "name": "CP-API-18 · Programar actividad en fecha pasada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/programacion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programacion"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2020-01-01\",\n  \"id_operario\": \"{{id_operario}}\",\n  \"id_proyecto\": \"{{id_proyecto}}\",\n  \"id_fase_proyecto\": \"{{id_fase}}\",\n  \"tiempo_estimado\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('Explica la regla de no-backdating', () => pm.expect(pm.response.json().message.toLowerCase()).to.match(/fecha|pasad|anterior/));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-API-19 · Programar actividad válida (mañana)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/programacion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programacion"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"{{manana}}\",\n  \"id_operario\": \"{{id_operario}}\",\n  \"id_proyecto\": \"{{id_proyecto}}\",\n  \"id_fase_proyecto\": \"{{id_fase}}\",\n  \"tiempo_estimado\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 1);",
                  "const p = n => String(n).padStart(2, '0');",
                  "pm.collectionVariables.set('manana', `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.test('Queda en estado programado', () => pm.expect(t.estado).to.eql('programado'));",
                  "pm.collectionVariables.set('id_turno', t.id_programacion);"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-API-20 · Mismo operario, mismo día (doble asignación)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/programacion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "programacion"
              ]
            },
            "body": {
