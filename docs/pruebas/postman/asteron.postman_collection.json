                  "pm.test('Solo programadas o en curso', () => filas.forEach(f => pm.expect(['programado', 'en_proceso']).to.include(f.estado)));",
                  "pm.test('Incluye la actividad creada, en curso', () => {",
                  "  const t = filas.find(f => f.id_programacion === pm.collectionVariables.get('id_turno'));",
                  "  pm.expect(t, 'actividad').to.exist;",
                  "  pm.expect(t.estado).to.eql('en_proceso');",
                  "});"
