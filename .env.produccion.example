# Variables de producción para docker-compose.prod.yml.
#   cp .env.produccion.example .env.produccion
# .env.produccion está en .gitignore: NUNCA subirlo al repositorio.
# Genera cada contraseña y secreto con:  openssl rand -hex 32

# Dominio que apunta a la IP del servidor (registro DNS tipo A) y correo para
# los avisos de Let's Encrypt sobre el certificado
DOMINIO=asteron.ejemplo.com
CORREO_ACME=tu-correo@ejemplo.com

# MySQL: root solo lo usan los respaldos; el backend usa MYSQL_USER
MYSQL_ROOT_PASSWORD=
MYSQL_USER=asteron_app
MYSQL_PASSWORD=

# Mínimo 32 caracteres; el backend no arranca con uno corto o con el de ejemplo
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Correo para "Olvidé mi contraseña" (cuenta de Gmail con contraseña de aplicación)
EMAIL_USER=
EMAIL_PASS=

# Orígenes extra para CORS: los de la app móvil (Capacitor iOS y Android)
CORS_ORIGINS_EXTRA=capacitor://localhost,http://localhost

# Documentación Swagger en https://DOMINIO/api/docs (false para ocultarla)
DOCS_HABILITADOS=true

# Cuántos respaldos diarios se conservan
RETENER_RESPALDOS=14
