PORT=3000

# Base de datos MySQL — pon la contraseña de tu usuario root (vacío si no tiene contraseña)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=asteron

# JWT — en desarrollo puedes dejar este valor. En producción el backend NO arranca con
# él: usa uno de 32+ caracteres generado con `openssl rand -hex 32`
JWT_SECRET=asteron_super_secret_2026
JWT_EXPIRES_IN=8h

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Correo para recuperación de contraseña (opcional)
EMAIL_USER=
EMAIL_PASS=

# ── Solo producción (docker-compose.prod.yml ya los define) ──
# NODE_ENV=production
# CORS_ORIGINS=https://tu-dominio,capacitor://localhost,http://localhost
# TRUST_PROXY=1                # detrás de Caddy u otro proxy
# DOCS_HABILITADOS=false       # ocultar Swagger
# TZ=America/Bogota            # el Dockerfile ya la fija
